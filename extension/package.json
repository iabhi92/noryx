{
  "name": "meow-mentor-extension",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev:dashboard": "vite",
    "build:bg": "esbuild src/background/index.ts --bundle --outfile=dist/background.js --format=iife --target=es2020",
    "build:cs": "esbuild src/content-scripts/universal.ts --bundle --outfile=dist/content-scripts/universal.js --format=iife --target=es2020",
    "build:dashboard": "vite build",
    "build:assets": "node scripts/copy-assets.mjs",
    "build": "npm run build:bg && npm run build:cs && npm run build:dashboard && npm run build:assets",
    "typecheck": "tsc --noEmit",
    "icons": "python3 scripts/generate-icons.py",
    "check:intervention": "esbuild src/lib/ai/intervention.check.ts --bundle --platform=node --format=cjs --outfile=/tmp/meow-mentor-intervention-check.cjs && node /tmp/meow-mentor-intervention-check.cjs",
    "check:stats": "esbuild src/lib/stats.check.ts --bundle --platform=node --format=cjs --outfile=/tmp/meow-mentor-stats-check.cjs && node /tmp/meow-mentor-stats-check.cjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.280",
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "esbuild": "^0.24.0",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  }
}
